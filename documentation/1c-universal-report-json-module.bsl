// Универсальная обработка формирования сохраненных вариантов СКД в JSON.
//
// Результат:
// {
//   "reportKey": "...",
//   "reportName": "...",
//   "variantKey": "...",
//   "variantName": "...",
//   "schemaVersion": 2,
//   "generatedAt": "2026-06-04T12:00:00",
//   "periodStart": "2026-06-01T00:00:00",
//   "periodEnd": "2026-06-30T23:59:59",
//   "outputMode": "tabular-document-matrix",
//   "width": 10,
//   "height": 100,
//   "rows": [
//     { "rowNumber": 1, "cells": ["...", "..."] }
//   ]
// }

Процедура ВыполнитьЗадание() Экспорт

	ВыполнитьОбработку(Неопределено);

КонецПроцедуры


Процедура ВыполнитьОбработку(Команда) Экспорт

	СписокВыгрузок = ПолучитьСписокВыгрузок();

	Для Каждого НастройкаВыгрузки Из СписокВыгрузок Цикл

		Сообщить("========================================");
		Сообщить("Начало формирования: " + НастройкаВыгрузки.ИмяФайла);

		НастройкиВарианта = ПолучитьНастройкиИзСправочника(
			НастройкаВыгрузки.ИмяОтчета,
			НастройкаВыгрузки.КлючВарианта
		);

		Если НастройкиВарианта = Неопределено Тогда
			Сообщить("Не удалось получить настройки варианта: " + НастройкаВыгрузки.ИмяВарианта);
			Продолжить;
		КонецЕсли;

		ПутьКФайлу = НастройкаВыгрузки.ПапкаСохранения + НастройкаВыгрузки.ИмяФайла;

		СформироватьИСохранитьJSON(
			НастройкаВыгрузки,
			НастройкиВарианта,
			ПутьКФайлу
		);

	КонецЦикла;

	Сообщить("========================================");
	Сообщить("Выгрузка завершена.");

КонецПроцедуры


