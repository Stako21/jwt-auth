Функция ПолучитьНастройкиИзСправочника(ИмяОтчета, КлючВарианта) Экспорт

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВариантыОтчетов.ХранилищеЗначений КАК Хранилище
		|ИЗ
		|	Справочник.ВариантыОтчетов КАК ВариантыОтчетов
		|ГДЕ
		|	ВариантыОтчетов.КлючВарианта = &КлючВарианта
		|	И ВариантыОтчетов.КлючОбъекта = &КлючОбъекта
		|	И ВариантыОтчетов.ПометкаУдаления = ЛОЖЬ";

		Запрос.УстановитьПараметр("КлючВарианта", КлючВарианта);
		Запрос.УстановитьПараметр("КлючОбъекта", "Отчет." + ИмяОтчета);

		Результат = Запрос.Выполнить().Выбрать();

		Если Не Результат.Следующий() Тогда
			Сообщить("Вариант отчета с ключом не найден: " + КлючВарианта);
			Возврат Неопределено;
		КонецЕсли;

		Если Результат.Хранилище = Неопределено Тогда
			Сообщить("У варианта отчета пустое ХранилищеЗначений.");
			Возврат Неопределено;
		КонецЕсли;

		Возврат Результат.Хранилище.Получить();

	Исключение

		Сообщить("Ошибка при получении настроек варианта: " + ОписаниеОшибки());
		Возврат Неопределено;

	КонецПопытки;

КонецФункции


Процедура СформироватьИСохранитьJSON(НастройкаВыгрузки, НастройкиВарианта, ПутьКФайлу) Экспорт

	Попытка

		СхемаКомпоновки = Отчеты[НастройкаВыгрузки.ИмяОтчета].ПолучитьМакет(
			НастройкаВыгрузки.ИмяСхемы
		);

		Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
		Компоновщик.Инициализировать(
			Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки)
		);
		Компоновщик.ЗагрузитьНастройки(НастройкиВарианта);

		Настройки = Компоновщик.Настройки;

		Если НастройкаВыгрузки.ИспользоватьПериод Тогда
			УстановитьПериодОтчета(
				Настройки,
				НастройкаВыгрузки.НачалоПериода,
				НастройкаВыгрузки.КонецПериода
			);
		КонецЕсли;

		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		Макет = КомпоновщикМакета.Выполнить(СхемаКомпоновки, Настройки);

		Процессор = Новый ПроцессорКомпоновкиДанных;
		Процессор.Инициализировать(Макет);

		ТабДок = Новый ТабличныйДокумент;
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(ТабДок);

		ПроцессорВывода.НачатьВывод();

		Пока Истина Цикл

			ЭлементРезультата = Процессор.Следующий();

			Если ЭлементРезультата = Неопределено Тогда
				Прервать;
			КонецЕсли;

			ПроцессорВывода.ВывестиЭлемент(ЭлементРезультата);

		КонецЦикла;

		ПроцессорВывода.ЗакончитьВывод();

		ДанныеJSON = ПодготовитьДанныеJSON(
			НастройкаВыгрузки,
			Настройки,
			ТабДок
		);

		ЗаписатьДанныеJSONВФайл(ДанныеJSON, ПутьКФайлу);

		Сообщить("JSON сохранен: " + ПутьКФайлу);

	Исключение

		Сообщить(
			"Ошибка при формировании JSON """
			+ НастройкаВыгрузки.ИмяВарианта
			+ """: "
			+ ОписаниеОшибки()
		);

	КонецПопытки;

КонецПроцедуры


Процедура УстановитьПериодОтчета(Настройки, НачалоПериода, КонецПериода) Экспорт

	ПарамНач = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("НачалоПериода")
	);

	Если ПарамНач <> Неопределено Тогда
		ПарамНач.Значение = НачалоПериода;
		ПарамНач.Использование = Истина;
	КонецЕсли;

	ПарамКон = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("КонецПериода")
	);

	Если ПарамКон <> Неопределено Тогда
		ПарамКон.Значение = КонецПериода;
		ПарамКон.Использование = Истина;
	КонецЕсли;

КонецПроцедуры


Функция ПодготовитьДанныеJSON(НастройкаВыгрузки, Настройки, ТабДок) Экспорт

	СтрокиJSON = ТабличныйДокументВСтрокиJSON(ТабДок);

	Результат = Новый Структура;
	Результат.Вставить("reportKey", НастройкаВыгрузки.КлючAPI);
	Результат.Вставить("reportName", НастройкаВыгрузки.ИмяОтчета);
	Результат.Вставить("variantKey", НастройкаВыгрузки.КлючВарианта);
	Результат.Вставить("variantName", НастройкаВыгрузки.ИмяВарианта);
	Результат.Вставить("schemaVersion", 2);
	Результат.Вставить("generatedAt", ДатаВСтрокуJSON(ТекущаяДата()));
	Результат.Вставить(
		"periodStart",
		ПолучитьПараметрПериодаJSON(Настройки, "НачалоПериода")
	);
	Результат.Вставить(
		"periodEnd",
		ПолучитьПараметрПериодаJSON(Настройки, "КонецПериода")
	);
	Результат.Вставить("outputMode", "tabular-document-matrix");
	Результат.Вставить("width", ТабДок.ШиринаТаблицы);
	Результат.Вставить("height", ТабДок.ВысотаТаблицы);
	Результат.Вставить("rows", СтрокиJSON);

	Возврат Результат;

КонецФункции


Функция ТабличныйДокументВСтрокиJSON(ТабДок) Экспорт

	Результат = Новый Массив;

	Для НомерСтроки = 1 По ТабДок.ВысотаТаблицы Цикл

		ЯчейкиJSON = Новый Массив;
		ЕстьДанные = Ложь;

		Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл

			ОбластьЯчейки = ТабДок.Область(
				НомерСтроки,
				НомерКолонки,
				НомерСтроки,
				НомерКолонки
			);

			ТекстЯчейки = ОбластьЯчейки.Текст;
			ЯчейкиJSON.Добавить(ТекстЯчейки);

			Если Не ПустаяСтрока(ТекстЯчейки) Тогда
				ЕстьДанные = Истина;
			КонецЕсли;

		КонецЦикла;

		Если ЕстьДанные Тогда
			СтрокаJSON = Новый Структура;
			СтрокаJSON.Вставить("rowNumber", НомерСтроки);
			СтрокаJSON.Вставить("cells", ЯчейкиJSON);
			Результат.Добавить(СтрокаJSON);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции


Функция ПолучитьПараметрПериодаJSON(Настройки, ИмяПараметра) Экспорт

	Попытка

		Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
			Новый ПараметрКомпоновкиДанных(ИмяПараметра)
		);

		Если Параметр <> Неопределено
			И ТипЗнч(Параметр.Значение) = Тип("Дата") Тогда

			Возврат ДатаВСтрокуJSON(Параметр.Значение);
		КонецЕсли;

	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции


Функция ДатаВСтрокуJSON(ДатаЗначение) Экспорт

	Возврат Формат(ДатаЗначение, "ДФ=yyyy-MM-ddTHH:mm:ss");

КонецФункции


Процедура ЗаписатьДанныеJSONВФайл(Данные, ПутьКФайлу) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	ЗаписьТекста = Новый ЗаписьТекста(
		ПутьКФайлу,
		КодировкаТекста.UTF8
	);
	ЗаписьТекста.Записать(СтрокаJSON);
	ЗаписьТекста.Закрыть();

КонецПроцедуры
